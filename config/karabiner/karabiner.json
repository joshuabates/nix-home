{
  "global": {
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default profile",
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock → Hyper Key (⌘⌃⌥⇧) when held, Escape when tapped alone",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "hyper",
                      "value": 1
                    }
                  },
                  {
                    "key_code": "left_shift",
                    "modifiers": [
                      "left_command",
                      "left_control",
                      "left_option"
                    ]
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "hyper",
                      "value": 0
                    }
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "escape"
                  }
                ],
                "parameters": {
                  "basic.to_if_alone_timeout_milliseconds": 250
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
